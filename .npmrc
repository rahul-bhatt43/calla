# pnpm ships its own bundled Node and puts it first on PATH when running
# scripts, which here means Node 20. uWebSockets.js only publishes prebuilt
# binaries for Node 22/24/26, so without this pin `pnpm dev` fails to even load
# the signal server. pnpm downloads and uses this version for every script,
# which also makes CI and a teammate's laptop behave identically.
use-node-version=22.20.0

# Next.js and Tailwind resolve some deps by walking node_modules; hoisting these
# patterns avoids "module not found" in a strict pnpm store.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*tailwind*
strict-peer-dependencies=false
auto-install-peers=true
