# Copy to .env and adjust. `pnpm infra:up` reads this file too.

# --- Core --------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SIGNAL_URL=ws://localhost:3001/ws

# --- Postgres ----------------------------------------------------------------
# If you already run Postgres or Redis locally, change the *_PORT values (and
# the matching URL) rather than stopping the other stack — every service reads
# its port from here, so a shift is a one-line change per service.
POSTGRES_USER=callme
POSTGRES_PASSWORD=callme
POSTGRES_DB=callme
POSTGRES_PORT=5432
DATABASE_URL=postgresql://callme:callme@localhost:5432/callme

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Signaling ---------------------------------------------------------------
SIGNAL_PORT=3001
SIGNAL_HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3100
# Number of queue entries the matchmaker inspects per attempt.
MATCH_SCAN_LIMIT=60
EVIDENCE_DIR=./data/evidence

# --- Auth --------------------------------------------------------------------
# Sign cookies and derive IP hash salts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-session-secret-change-me-please-32-bytes-min

# --- TURN --------------------------------------------------------------------
# MUST match `static-auth-secret` in infra/coturn/turnserver.conf.
TURN_SECRET=dev-turn-secret-change-me
TURN_REALM=localhost
TURN_HOST=localhost
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_CREDENTIAL_TTL=3600

# --- Production only ---------------------------------------------------------
SITE_DOMAIN=localhost
ACME_EMAIL=admin@localhost
